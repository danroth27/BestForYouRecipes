@inject NavigationManager NavigationManager
<div class="reviews">
    <h2>Reviews</h2>
    <EditForm method="post" class="review-editor" Model="review" OnValidSubmit="OnValidSubmit" FormName="star-review" Enhance @ref="editForm">
        <DataAnnotationsValidator />

        <StarRating @bind-Value="review.Rating" />
        <ValidationMessage For="() => review.Rating" />

        <InputTextArea rows="5" placeholder="Write a review" @bind-Value="review.Text" />
        <ValidationMessage For="() => review.Text" />

        <button type="submit">Submit</button>
    </EditForm>
    @for (int i = 0; i < Reviews.Count; i++)
    {
        var review = Reviews[i];
        <div class="review">
            <StarRating Value="review.Rating" />
            <p>@review.Text</p>
            @if (i < Reviews.Count - 1)
            {
                <hr />
            }
        </div>
    }
</div>

@code {
    Review review = new();
    EditForm? editForm;

    [SupplyParameterFromForm]
    public Review Review { get; set; } = new();

    [Parameter, EditorRequired]
    public IList<Review> Reviews { get; set; } = default!;

    [Parameter]
    public EventCallback<Review> OnSubmitReview { get; set; }

    protected override void OnInitialized()
    {
        review = Review;
    }

    protected override void OnParametersSet()
    {
        // Reset review if it has values but Review parameter is empty (after form submission)
        if (review.Rating != 0 || !string.IsNullOrEmpty(review.Text))
        {
            if (Review.Rating == 0 && string.IsNullOrEmpty(Review.Text))
            {
                review = new Review();
            }
            else
            {
                review = Review;
            }
        }
    }

    async Task OnValidSubmit()
    {
        await OnSubmitReview.InvokeAsync(review);
        review = new Review();
        Review = new Review();
        editForm?.EditContext?.MarkAsUnmodified();
        StateHasChanged();
        NavigationManager.NavigateTo(NavigationManager.Uri);
    }
}
